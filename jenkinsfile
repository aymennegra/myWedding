pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                sh 'chmod +x mvnw'            // <-- Ajout pour donner les droits d'exécution
                sh './mvnw clean package -DskipTests'
            }
        }

        stage('Unit Test') {
            steps {
                sh './mvnw test'
            }
        }

        stage('Run Application') {
            steps {
                echo 'Application build complete. Ready to deploy or run.'
                // Optionnel : sh 'java -jar target/monapp.jar'
            }
        }
    }
}
